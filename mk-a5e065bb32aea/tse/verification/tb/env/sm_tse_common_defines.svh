//------------------------SFP/QSFP-----------------------------//
`ifndef SM_TSE_SFP_SYSTEM_OFFSET
  `define SM_TSE_SFP_SYSTEM_OFFSET 'h4404_0000
`endif

`ifndef SM_TSE_SFP_CFG_REG
  `define SM_TSE_SFP_CFG_REG (`SM_TSE_SFP_SYSTEM_OFFSET + 'h20)
`endif

